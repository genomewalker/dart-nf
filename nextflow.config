manifest {
    name = 'dart-nf'
    description = 'DART v2.0.0 workflow: damage profile, gene prediction with decoys, MMseqs2 search, EMI with decoy null, damage annotation, report'
    version = '0.1.0'
    nextflowVersion = '>=25.10'
}

params {
    samplesheet = null                      // CSV with columns sample,reads[,profile_reads]
    db = null                               // protein FASTA (.faa, .faa.gz) or an MMseqs2 database prefix
    vtml20 = "${projectDir}/test/VTML20.out"
    outdir = 'results'

    dart = 'dart'                           // path to the dart binary (v2.0.0, 344d19f)
    mmseqs = 'mmseqs'                       // path to mmseqs (15.6f452 tested)

    decoy_every = 10                        // predict writes the reversed protein of every N-th read as a decoy
    domain = 'meta'                         // predict --domain
    library_type = 'auto'                   // profile --library-type: auto, ds or ss
    search_params = '--search-type 1 --min-length 12 -e 10.0 --min-seq-id 0.86 -c 0.65 --cov-mode 2 -s 2 -k 6 --spaced-kmer-pattern 11011101'
    null_p_max = 0.05                       // damage-annotate --null-p-max
    annotate_params = '--auto-calibrate-spurious'

    // Where MMSEQS_SEARCH and DAMAGE_ANNOTATE run: true = the node's $TMPDIR or /tmp (Nextflow's
    // scratch default), a path = that directory, false = the work directory. The EM tape needs a
    // disk that supports O_DIRECT (not tmpfs). The local and slurm profiles set /local/scratch.
    scratch = true

    expected = null                         // per-read table to compare the run against (set by -profile test)
}

process {
    cpus = 8
    memory = 16.GB
    time = 4.h
    // Closure: resolved per task, so a profile's params.scratch applies too. --scratch true/false
    // from the command line arrive as strings; map them to the booleans.
    withName: 'MMSEQS_SEARCH' {
        cpus = 16
        memory = 32.GB
        scratch = { params.scratch in [false, 'false', ''] ? false : (params.scratch in [true, 'true'] ? true : params.scratch) }
    }
    withName: 'DAMAGE_ANNOTATE' {
        scratch = { params.scratch in [false, 'false', ''] ? false : (params.scratch in [true, 'true'] ? true : params.scratch) }
    }
}

profiles {
    test {
        params.samplesheet = "${projectDir}/test/samplesheet.csv"
        params.db = "${projectDir}/test/ref_proteins.faa.gz"
        params.expected = "${projectDir}/test/expected/annotated.tsv.gz"
        process {
            cpus = 8                        // the expected table was produced at 8 threads
            memory = 16.GB
            withName: 'MMSEQS_SEARCH' { cpus = 8 }
        }
    }
    // Tutorial reads against 1,002,005 AFDB proteins (a uniform random 1M subset of the 241M
    // afdb_members, seed 42), large enough for chance hits to fit the decoy null. Decoys from every
    // 2nd read (about 74,000). Override --db with your copy of the subset.
    example {
        params.samplesheet = "${projectDir}/test/samplesheet.csv"
        params.db = '/path/to/tmp/afdb_subset_null/afdb_1M.faa.gz'
        params.decoy_every = 2
        params.expected = null
    }
    local {
        process.executor = 'local'
        params.scratch = '/local/scratch'
        params.dart = '/path/to/tmp/dart_release_v2/build/dart'
        params.mmseqs = '/path/to/opt/conda/envs/bioinfo/bin/mmseqs'
    }
    conda {
        conda.enabled = true
        process {
            withName: 'MMSEQS_SEARCH' { conda = 'bioconda::mmseqs2=15.6f452' }
        }
    }
    slurm {
        process.executor = 'slurm'
        params.scratch = '/local/scratch'
        executor.queueSize = 50
    }
}
